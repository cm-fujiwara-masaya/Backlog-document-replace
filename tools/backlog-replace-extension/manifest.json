{
  "manifest_version": 3,
  "name": "Backlog Document Find & Replace",
  "version": "0.2.0",
  "description": "Backlogドキュメントのテキスト一括置換Chrome拡張",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "https://*.backlog.com/*",
    "https://*.backlog.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.backlog.com/*", "https://*.backlog.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
